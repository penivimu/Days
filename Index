<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>👃</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0a0a0c;
        color: white;
        font-family: Arial, sans-serif;
        text-align: center;
    }

    .contenedor {
        width: 90%;
        max-width: 420px;
    }

    .numero {
        font-size: 100px;
        font-weight: bold;
        color: #d6ad60;
        margin: 0;
    }

    .fecha {
        color: #999;
        font-size: 16px;
        margin-top: 5px;
    }

    .porcentaje {
        font-size: 24px;
        margin-top: 45px;
    }

    .barra {
        width: 100%;
        height: 16px;
        background: #292929;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 20px;
    }

    .relleno {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #a87932, #ffe0a0);
        border-radius: 20px;
        transition: width 1s;
    }

    .nariz {
        font-size: 65px;
        margin-top: 35px;
    }

    .progreso-nariz {
        font-size: 17px;
        color: #777;
        margin-top: 10px;
    }
</style>
</head>

<body>
    <div class="contenedor">

        <p class="numero" id="dias">0</p>
        <p class="fecha">Hasta el 7 de noviembre</p>

        <p class="porcentaje" id="porcentaje">0% completado</p>

        <div class="barra">
            <div class="relleno" id="relleno"></div>
        </div>

        <div class="nariz">👃</div>
        <p class="progreso-nariz" id="texto">Preparando...</p>

    </div>

<script>
    const inicio = new Date(2026, 7, 21);
    const final = new Date(2026, 10, 7);

    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);

    const duracion = final - inicio;
    const transcurrido = hoy - inicio;

    const porcentaje = Math.round(
        Math.max(0, Math.min(100, transcurrido / duracion * 100))
    );

    const dias = Math.max(
        0,
        Math.ceil((final - hoy) / 86400000)
    );

    document.getElementById("dias").textContent = dias;
    document.getElementById("porcentaje").textContent =
        porcentaje + "% completado";

    document.getElementById("relleno").style.width =
        porcentaje + "%";

    document.getElementById("texto").textContent =
        porcentaje === 100
        ? "👃 Nariz completada"
        : "👃 " + porcentaje + "% de nariz completada";
</script>
</body>
</html>
