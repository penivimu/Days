<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuenta atrás 👃</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #111;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        .contenedor {
            width: 90%;
            max-width: 400px;
        }

        h1 {
            font-size: 65px;
            margin: 10px;
        }

        .porcentaje {
            font-size: 22px;
            color: #aaa;
        }

        .nariz {
            font-size: 45px;
            letter-spacing: 3px;
            margin-top: 25px;
        }

        .barra {
            background: #333;
            height: 12px;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 15px;
        }

        .relleno {
            height: 100%;
            width: 0%;
            background: #d6a85c;
            transition: width 0.5s;
        }
    </style>
</head>

<body>
    <div class="contenedor">
        <p>Faltan</p>
        <h1 id="dias">0</h1>
        <p>días para el 7 de noviembre</p>

        <p class="porcentaje" id="porcentaje"></p>

        <div class="nariz" id="nariz">👃</div>

        <div class="barra">
            <div class="relleno" id="relleno"></div>
        </div>
    </div>

    <script>
        const inicio = new Date("2026-08-21T00:00:00");
        const final = new Date("2026-11-07T00:00:00");
        const hoy = new Date();

        const duracion = final - inicio;
        const transcurrido = hoy - inicio;

        let porcentaje = Math.round(
            Math.max(0, Math.min(1, transcurrido / duracion)) * 100
        );

        const diasRestantes = Math.max(
            0,
            Math.ceil((final - hoy) / (1000 * 60 * 60 * 24))
        );

        document.getElementById("dias").textContent = diasRestantes;
        document.getElementById("porcentaje").textContent =
            "Se ha completado el " + porcentaje + "%";

        document.getElementById("relleno").style.width =
            porcentaje + "%";

        // La nariz se va rellenando con el porcentaje
        const nariz = "👃";
        const vacio = "▫️";
        const bloques = 10;
        const llenos = Math.round(porcentaje / 10);

        document.getElementById("nariz").textContent =
            nariz + " " + "🟫".repeat(llenos) + "⬛".repeat(bloques - llenos);
    </script>
</body>
</html>
